{
  "_comment": "Copy to tools.json and fill in your endpoints. 'llm' is the shared brain (default: the local llama.cpp docker agent); chat agents + the intent router inherit it when their own url is empty. An agent is ENABLED when it has a resolvable url (its own, or the shared llm for chat agents). To route intent with a smaller EXTERNAL LLM instead of the local docker agent, set intent.url. Hot-reloads on edit. tools.json is gitignored (it holds your keys/IPs).",

  "proxy_host": "192.168.1.10:8001",

  "llm": {
    "url": "http://llama.cpp:8080/v1/chat/completions",
    "model": "qwen2.5-3b-instruct",
    "api_key": "",
    "reasoning_effort": "none"
  },

  "intent": {
    "url": "",
    "model": "",
    "api_key": ""
  },

  "stt": {
    "enabled": true,
    "engine": "whisper",
    "model": "base",
    "language": "en"
  },

  "agents": {
    "chat_agent": {
      "type": "chat",
      "url": "",
      "system": "You are Loona, a small friendly pet robot. Keep replies short (1-2 sentences) and speakable - your answer is turned into speech. No markdown, no lists."
    },
    "draw_agent": {
      "type": "image",
      "url": "",
      "api_key": "",
      "model": ""
    },
    "assist_agent": {
      "type": "chat",
      "url": "",
      "api_key": "",
      "model": "",
      "system": "You are Loona's assistant, helping the owner with how to use the robot and troubleshooting."
    },
    "charge_setting_agent": {
      "type": "command",
      "url": ""
    },
    "close_agent": {
      "type": "builtin"
    }
  },

  "visual": {
    "enabled": true,
    "frame_path": "/tmp/loona_frames/latest.jpg"
  }
}
